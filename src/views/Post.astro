---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { getPosts, getProjects, shortDate, type Post } from "../lib/site";
import { href, other, t, type Lang } from "../lib/i18n";

interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const project = d.proje ? (await getProjects(lang)).find((p) => p.id === d.proje!.id) : undefined;

// Point the switcher at the same post in the other language, or at its post list if it is not translated.
const o = other(lang);
const translated = (await getPosts(o)).some((p) => p.id === post.id);
const alternates = { [o]: translated ? href(o, "posts", post.id) : href(o, "posts") };
---
<Base title={d.title} description={d.subtitle} alternates={alternates}>
  <a class="back mono" href={href(lang, "posts")}>← {t[lang].posts}</a>

  <article>
    <div class="p-head">
      <h1>{d.title}</h1>
      <p class="lead">{d.subtitle}</p>
      <div class="meta mono">
        <time datetime={d.date.toISOString()}>{shortDate(d.date)}</time>
        {project && <a href={href(lang, "projects", project.id)}>{project.data.title}</a>}
      </div>
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
