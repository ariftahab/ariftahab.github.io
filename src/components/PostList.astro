---
import { shortDate, type Post } from "../lib/site";
import { href, t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  posts: Post[];
  empty?: string;
}
const { lang, posts, empty = t[lang].noPosts } = Astro.props;
---
{posts.length === 0 && <p class="empty">{empty}</p>}
{posts.map((p) => (
  <a class="post" href={href(lang, "posts", p.id)}>
    <span class="title">{p.data.title}{p.data.draft && <span class="tag mono">{t[lang].draft}</span>}</span>
    <time class="mono" datetime={p.data.date.toISOString()}>{shortDate(p.data.date)}</time>
    <span class="sub">{p.data.subtitle}</span>
  </a>
))}
