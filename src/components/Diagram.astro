---
// Renders a system diagram as inline SVG at build time (no client JavaScript).
// Layout is a grid: each node sits in a column/row cell; groups are dashed boxes around a block of cells.
import type { Diagram } from "../lib/diagram";

interface Props { diagram: Diagram }
const { diagram } = Astro.props;

const W = diagram.width ?? 720;
const M = 8; // outer margin
const ROW_H = 96;
const NODE_H = 48;
const colW = (W - 2 * M) / diagram.cols;
const rows = Math.max(...diagram.nodes.map((n) => n.row)) + 1;
const H = rows * ROW_H + 8;

type Box = { x: number; y: number; w: number; h: number; cx: number; cy: number };
const box = (col: number, row: number, span = 1): Box => {
  const x = M + col * colW + 10;
  const w = span * colW - 20;
  const y = row * ROW_H + 34;
  return { x, y, w, h: NODE_H, cx: x + w / 2, cy: y + NODE_H / 2 };
};

const boxes = new Map(diagram.nodes.map((n) => [n.id, box(n.col, n.row, n.span)]));

// Shrink text that would overflow its box (monospace: ~0.6em per character).
const fit = (text: string, size: number, max: number) =>
  text.length * size * 0.6 > max ? { textLength: max, lengthAdjust: "spacingAndGlyphs" } : {};

// Edges leave from the side facing the target: left/right when the horizontal gap dominates, else top/bottom.
const edges = (diagram.edges ?? []).map((e) => {
  const a = boxes.get(e.from)!, b = boxes.get(e.to)!;
  const dx = b.cx - a.cx, dy = b.cy - a.cy;
  const horizontal = e.dir
    ? e.dir === "h"
    : Math.abs(dx) > colW * 0.6 && Math.abs(dx) * (ROW_H / colW) >= Math.abs(dy) * 0.5;
  let p0, p3, c1, c2;
  if (horizontal) {
    const s = Math.sign(dx);
    p0 = { x: a.cx + (s * a.w) / 2, y: a.cy };
    p3 = { x: b.cx - (s * b.w) / 2, y: b.cy };
    const k = Math.abs(p3.x - p0.x) / 2;
    c1 = { x: p0.x + s * k, y: p0.y };
    c2 = { x: p3.x - s * k, y: p3.y };
  } else {
    const s = Math.sign(dy) || 1;
    p0 = { x: a.cx, y: a.cy + (s * a.h) / 2 };
    p3 = { x: b.cx, y: b.cy - (s * b.h) / 2 };
    const k = Math.abs(p3.y - p0.y) / 2;
    c1 = { x: p0.x, y: p0.y + s * k };
    c2 = { x: p3.x, y: p3.y - s * k };
  }
  const mid = { x: (p0.x + 3 * c1.x + 3 * c2.x + p3.x) / 8, y: (p0.y + 3 * c1.y + 3 * c2.y + p3.y) / 8 };
  return { ...e, d: `M${p0.x} ${p0.y} C${c1.x} ${c1.y} ${c2.x} ${c2.y} ${p3.x} ${p3.y}`, mid };
});

const groups = (diagram.groups ?? []).map((g) => {
  const x = M + g.cols[0] * colW + 2;
  const y = g.rows[0] * ROW_H + 8;
  return { ...g, x, y, w: (g.cols[1] - g.cols[0] + 1) * colW - 4, h: (g.rows[1] - g.rows[0] + 1) * ROW_H - 8 };
});
---
<figure class="diagram-wrap">
  <div class="diagram-scroll">
    <svg class="diagram" viewBox={`0 0 ${W} ${H}`} style={`min-width:${Math.round(W * 0.8)}px`} role="img" aria-label={diagram.caption ?? "sistem şeması"}>
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 1 L9 5 L0 9" class="arrowhead" />
        </marker>
      </defs>

      {groups.map((g) => (
        <g>
          <rect class="group" x={g.x} y={g.y} width={g.w} height={g.h} rx="10" />
          <text class="group-label" x={g.x + 12} y={g.y + 16}>{g.label}</text>
        </g>
      ))}

      {edges.map((e) => (
        <path d={e.d} class={e.dashed ? "edge dashed" : "edge"} marker-end="url(#arrow)" marker-start={e.both ? "url(#arrow)" : undefined} />
      ))}

      {edges.filter((e) => e.label).map((e) => (
        <text class="edge-label" x={e.mid.x} y={e.mid.y - 6}>{e.label}</text>
      ))}

      {diagram.nodes.map((n) => {
        const b = boxes.get(n.id)!;
        const cls = ["node", n.hl && "hl", n.store && "store"].filter(Boolean).join(" ");
        return (
          <g>
            <rect class={cls} x={b.x} y={b.y} width={b.w} height={b.h} rx={n.store ? 16 : 6} />
            <text class="label" x={b.cx} y={n.sub ? b.cy - 7 : b.cy} {...fit(n.label, 13, b.w - 14)}>{n.label}</text>
            {n.sub && <text class="sub" x={b.cx} y={b.cy + 11} {...fit(n.sub, 10.5, b.w - 14)}>{n.sub}</text>}
          </g>
        );
      })}
    </svg>
  </div>
  {diagram.caption && <figcaption class="mono">{diagram.caption}</figcaption>}
</figure>
