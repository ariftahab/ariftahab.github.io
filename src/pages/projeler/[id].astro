---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import Diagram from "../../components/Diagram.astro";
import { u, getPosts, shortDate } from "../../lib/site";

export async function getStaticPaths() {
  const projects = await getCollection("projeler");
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const posts = (await getPosts()).filter((p) => p.data.proje?.id === project.id); // newest first, for the list
// The same posts, oldest first, rendered in full so the project page reads as one continuous story.
const story = await Promise.all(
  [...posts].reverse().map(async (post) => ({ post, Content: (await render(post)).Content })),
);
const d = project.data;
---
<Base title={d.title} description={d.summary}>
  <a class="back mono" href={u("projeler/")}>← projeler</a>

  <div class="p-head">
    <h1>{d.title}</h1>
    <p class="lead">{d.lead}</p>
    <div class="meta mono">
      <span>{d.year}</span>
      <span>{d.stack.join(" · ")}</span>
    </div>
    {d.github && <a class="gh mono" href={d.github}>GitHub'da incele →</a>}
  </div>

  {d.diagram && <Diagram diagram={d.diagram} />}

  {d.gallery && (
    <div class="gallery">
      {d.gallery.map((img) => (
        <figure><img src={u(img.src)} alt={img.alt} loading="lazy" /><figcaption class="mono">{img.alt}</figcaption></figure>
      ))}
    </div>
  )}

  {project.body?.trim() && (
    <div class="prose">
      <Content />
    </div>
  )}

  {story.map(({ post, Content }) => (
    <section class="story">
      <div class="story-head">
        <h2><a href={u(`yazilar/${post.id}/`)}>{post.data.title}</a></h2>
        <time class="mono" datetime={post.data.date.toISOString()}>{shortDate(post.data.date)}</time>
      </div>
      <div class="prose"><Content /></div>
    </section>
  ))}

  <h2 class="mono">bu projeyle ilgili yazılar</h2>
  <PostList posts={posts} empty="Bu proje hakkında henüz yazı yok." />
</Base>
