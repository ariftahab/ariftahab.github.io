---
import "../styles/global.css";
import { NAME, GITHUB, LINKEDIN, u } from "../lib/site";
import { LANGS, href, parsePath, other, t, type Lang } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  /** URLs of this page in each language. Defaults to the same page in the other language. */
  alternates?: Partial<Record<Lang, string>>;
}
const here = parsePath(Astro.url.pathname);
const lang = here.lang;
const s = t[lang];
const { title, description = s.description } = Astro.props;
const alternates: Record<Lang, string> = {
  [lang]: Astro.url.pathname,
  [other(lang)]: href(other(lang), here.page, here.id),
  ...Astro.props.alternates,
} as Record<Lang, string>;
const pageTitle = title ? `${title} · ${NAME}` : NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHome = here.page === "home";
// Tells Google who this site is about, so it can match searches for the name (also without Turkish letters).
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: NAME,
  alternateName: ["Arif Taha Bulbul", "Arif Bülbül", "Arif Bulbul"],
  url: new URL("/", Astro.site).href,
  sameAs: [GITHUB, LINKEDIN],
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href={u("sitemap-index.xml")} />
  <meta property="og:type" content={isHome ? "profile" : "article"} />
  <meta property="og:site_name" content={NAME} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === "tr" ? "tr_TR" : "en_US"} />
  {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], Astro.site)} />)}
  <link rel="icon" href={u("favicon.svg")} type="image/svg+xml" />
  <link rel="icon" href={u("favicon-32.png")} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={u("apple-touch-icon.png")} />
  <meta name="theme-color" content="#111111" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="bar">
    <a class="home" href={href(lang, "home")}>{NAME}</a>
    <nav class="mono">
      <a href={href(lang, "projects")}>{s.projects}</a>
      <a href={href(lang, "posts")}>{s.posts}</a>
      <a href={GITHUB}>github</a>
      <a href={href(lang, "contact")}>{s.contact}</a>
      <span class="lang">
        {LANGS.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {l === lang
              ? <span class="on" aria-current="true">{l}</span>
              : <a href={alternates[l]} hreflang={l} lang={l}>{l}</a>}
          </>
        ))}
      </span>
    </nav>
  </div>

  <main>
    <slot />
  </main>

  <footer>
    <div class="in mono"><span>© {new Date().getFullYear()} {NAME}</span></div>
  </footer>

</body>
</html>
