---
import "../styles/global.css";
import { NAME, GITHUB, u } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = "RAG, agent'lar ve yerel modeller üzerine projeler ve yazılar." } = Astro.props;
const pageTitle = title ? `${title} · ${NAME}` : NAME;
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={u("favicon.svg")} type="image/svg+xml" />
  <link rel="icon" href={u("favicon-32.png")} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={u("apple-touch-icon.png")} />
  <meta name="theme-color" content="#111111" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="bar">
    <a class="home" href={u()}>{NAME}</a>
    <nav class="mono">
      <a href={u("projeler/")}>projeler</a>
      <a href={u("yazilar/")}>yazılar</a>
      <a href={GITHUB}>github</a>
      <a href={u("iletisim/")}>iletişim</a>
    </nav>
  </div>

  <main>
    <slot />
  </main>

  <footer>
    <div class="in mono"><span>© {new Date().getFullYear()} {NAME}</span></div>
  </footer>

</body>
</html>
